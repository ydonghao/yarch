APP_ENV=local
LISTEN_ADDR=:8080
LOG_LEVEL=INFO

# PG：内网用户连共享实例（共享 PG 上每个服务独立 database，启动时自动建库；
# 地址与凭证见内部约定，不入公开仓）。隔离纪律：database=服务名，Redis key 首段=服务名。
DATABASE_URL=postgres://postgres:CHANGE_ME@your-pg-host:5432/{{.ServiceSnake}}?sslmode=disable

# Redis：共享实例复用（key 前缀由 redix.Keys 强制，首段=服务名）
REDIS_ADDR=your-redis-host:6379

# 无共享实例时（开源采用者本地档）：docker compose up -d 起本机 PG+Redis，
# 并将上方主机名改为 localhost（凭证见 docker-compose.yml）。
