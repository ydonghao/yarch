<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.yuandonghao</groupId>
    <artifactId>yarch-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../platform/yarch-parent</relativePath>
  </parent>

  <artifactId>yarch-persistence-spring-boot-starter</artifactId>
  <name>yarch-persistence-spring-boot-starter</name>
  <description>PostgreSQL 规约落地件（J2 拍板 MyBatis-Plus）：逻辑删除 is_deleted↔deleted 三层映射链、审计自动填充（G7）、分页下推（G5）、keyset 游标、Flyway 迁移；MySQL 档为独立 starter（触发式）</description>

  <dependencies>
    <dependency>
      <groupId>io.github.yuandonghao</groupId>
      <artifactId>yarch-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Boot 4 拆分：Flyway 自动装配在独立模块 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>io.github.yuandonghao</groupId>
      <artifactId>yarch-test-spring-boot-starter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
