<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.yuandonghao</groupId>
    <artifactId>yarch-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../platform/yarch-parent</relativePath>
  </parent>

  <artifactId>yarch-web-spring-boot-starter</artifactId>
  <name>yarch-web-spring-boot-starter</name>
  <description>REST 契约落地件：统一信封、全局异常→错误码表映射、参数校验→1001、分页绑定、Idempotency-Key 幂等、springdoc</description>

  <dependencies>
    <dependency>
      <groupId>io.github.yuandonghao</groupId>
      <artifactId>yarch-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <!-- Boot 4 无 spring-boot-starter-aop；操作日志切面需织入器（版本由 Boot BOM 管理） -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 拆分后 @AutoConfigureMockMvc 在 webmvc 测试模块 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
