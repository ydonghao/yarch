{
  "meta": {
    "name": "yarch-base",
    "description": "yarch 设计 token 基线（框架无关；暗色只覆盖 color 组）"
  },
  "color": {
    "primary": "#1E86FF",
    "semantic": {
      "success": "#52C41A",
      "warning": "#FFC036",
      "error": "#FF4C4C",
      "info": "#1E86FF"
    },
    "neutral": {
      "bg": "#FFFFFF",
      "bg-raised": "#F8F9FA",
      "border": "#E5E8EB",
      "text": "#434B5B",
      "text-secondary": "#7A828F",
      "text-disabled": "#B8BEC7"
    }
  },
  "typography": {
    "font-family": "-apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "font-size": {
      "xs": "12px",
      "sm": "13px",
      "md": "14px",
      "lg": "16px",
      "xl": "20px"
    },
    "line-height": {
      "tight": "1.4",
      "normal": "1.6"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "xxl": "32px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.08)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.12)",
    "lg": "0 8px 24px rgba(0, 0, 0, 0.16)"
  },
  "modes": {
    "dark": {
      "color": {
        "primary": "#4096FF",
        "semantic": {
          "success": "#6ABF3F",
          "warning": "#E6B33D",
          "error": "#E55C5C",
          "info": "#4096FF"
        },
        "neutral": {
          "bg": "#1B1F27",
          "bg-raised": "#232935",
          "border": "#333B49",
          "text": "#D5DAE2",
          "text-secondary": "#9AA2B0",
          "text-disabled": "#5C6470"
        }
      }
    }
  }
}
