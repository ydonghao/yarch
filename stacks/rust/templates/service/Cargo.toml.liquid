[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2021"
description = "yarch rust 服务（axum + DDD 七包，cargo generate 产出）"

[dependencies]
yarch-contract = {{yarch_contract_dep}}
yarch-axum = {{yarch_axum_dep}}
axum = "0.8"
tokio = { version = "1", features = ["full"] }
sqlx = { version = "0.8", default-features = false, features = ["runtime-tokio", "postgres", "migrate", "macros", "chrono", "derive"] }
async-trait = "0.1"
chrono = { version = "0.4", features = ["serde"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
dotenvy = "0.15"

[dev-dependencies]
tower = { version = "0.5", features = ["util"] }
